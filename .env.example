# FastAPI Server
HOST=0.0.0.0
PORT=8888

# Cache directory for repositories cloned by git-sync
CACHE_DIR=/app/cache

# Sync interval (secondi)
GIT_SYNC_INTERVAL=604800 # 7 days

# Repository configuration (JSON array)
# Format: [{"name": "RepoName", "url": "https://...", "branch": "main", "enabled": true}, ...]
# REPOSITORIES: |
#     [
#        {
#            "name": "CasaOS AppStore",
#            "url": "https://github.com/IceWhaleTech/CasaOS-AppStore.git",
#            "branch": "main",
#            "priority": 100,
#            "enabled": false
#        },
#        {
#            "name": "LinuxServer",
#            "url": "https://github.com/WisdomSky/CasaOS-LinuxServer-AppStore.git",
#            "branch": "main",
#            "priority": 98,
#            "enabled": false
#        },
#        {
#            "name": "BigBear",
#            "url": "https://github.com/bigbeartechworld/big-bear-casaos.git",
#            "branch": "master",
#            "priority": 96,
#            "enabled": false
#        },
#        {
#            "name": "Coolstore",
#            "url": "https://github.com/WisdomSky/CasaOS-Coolstore.git",
#            "branch": "main",
#            "priority": 95,
#            "enabled": false
#        }
#     ]

# Portainer configuration (optional, for Portainer backend)
PORTAINER_BASE_URL=https://host.docker.internal:9443
PORTAINER_API_KEY=YOUR_API_KEY_HERE
PORTAINER_ENDPOINT_ID=3
PORTAINER_VERIFY_SSL=false
MOCK_MODE=false
DEBUG_MODE=false

# Arcane configuration (optional, for Arcane backend)
ARCANE_BASE_URL=http://arcane:3552
ARCANE_API_KEY=arc_replace_with_your_api_key
ARCANE_ENVIRONMENT_ID=0
ARCANE_VERIFY_SSL=false
ARCANE_MODE=auto

# Active backend: "portainer", "arcane", or "auto" (prefer configured backend)
ACTIVE_BACKEND=auto

# GitHub token (optional but recommended) — used for the GitHub API during
# imports. Without it the API is rate-limited (403) and imports fall back to
# git/html metadata. Generate one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Image used by docker-compose.prod.yml (defaults to the GHCR latest)
APPSTORE_IMAGE=ghcr.io/tosolini/appstore:latest

