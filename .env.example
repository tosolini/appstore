# FastAPI Server
HOST=0.0.0.0
PORT=8000

# Cache directory for repositories cloned by git-sync
CACHE_DIR=/app/cache

# Sync interval (secondi)
GIT_SYNC_INTERVAL=604800 # 7 days

# Repository configuration (JSON array)
# Format: [{"name": "RepoName", "url": "https://...", "branch": "main", "enabled": true}, ...]
# REPOSITORIES=[
#   {
#     "name": "CasaOS",
#     "url": "https://github.com/IceWhaleTech/CasaOS-AppStore.git",
#     "branch": "main",
#     "enabled": true
#   },
#   {
#     "name": "LinuxServer",
#     "url": "https://github.com/linuxserver/docker-templates.git",
#     "branch": "master",
#     "enabled": false
#   },
#   {
#     "name": "BigBear",
#     "url": "https://github.com/bigbeartechworld/big-bear-casaos.git",
#     "branch": "master",
#     "enabled": false
#   }
# ]

# Portainer configuration (optional, for Portainer backend)
PORTAINER_BASE_URL=https://host.docker.internal:9443
PORTAINER_API_KEY=YOUR_API_KEY_HERE
PORTAINER_ENDPOINT_ID=3
PORTAINER_VERIFY_SSL=false
MOCK_MODE=false
DEBUG_MODE=false

# Arcane configuration (optional, for Arcane backend)
ARCANE_BASE_URL=http://arcane:3552
ARCANE_API_KEY=arc_replace_with_your_api_key
ARCANE_ENVIRONMENT_ID=0
ARCANE_VERIFY_SSL=false
ARCANE_MODE=auto

# Active backend: "portainer", "arcane", or "auto" (prefer configured backend)
ACTIVE_BACKEND=auto

# Default GitHub import seed (bundled github-imports.txt).
# Reconciled on every startup: commit list changes + redeploy to auto-import.
# Set a URL to host the list in a separate repo instead of the bundled file.
# GITHUB_IMPORT_SEED_FILE=/app/github-imports.txt
# GITHUB_IMPORT_SEED_URL=https://raw.githubusercontent.com/<owner>/<repo>/main/github-imports.txt
# Optional: periodically re-check the list without restart (seconds, 0 = startup only)
# GITHUB_IMPORT_SEED_SYNC_INTERVAL=86400
# Optional: delete DB records whose URL was removed from the list (default false = keep)
# GITHUB_IMPORT_SEED_PRUNE=false

